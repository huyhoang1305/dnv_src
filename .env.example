APP_NAME="DNV - Doanh Nghiệp Việt"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://dnv1.biz

APP_LOCALE=vi
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=vi_VN
APP_TIMEZONE="Asia/Ho_Chi_Minh"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dnv1_biz
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=file

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@dnv1.biz"
MAIL_FROM_NAME="${APP_NAME}"

GHN_TOKEN=
GHN_SHOP_ID=
GHN_API_URL=https://online-gateway.ghn.vn/shiip/public-api/

VITE_APP_NAME="${APP_NAME}"
