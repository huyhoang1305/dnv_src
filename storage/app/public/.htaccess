# Chặn hoàn toàn việc thực thi mã nguồn (PHP, Python, CGI, Perl, Shell...) trong thư mục storage upload
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phar|inc|pl|py|cgi|asp|aspx|sh|bash|exe|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Vô hiệu hóa thực thi CGI và duyệt danh sách thư mục
Options -ExecCGI -Indexes

# Tắt engine PHP nếu máy chủ dùng mod_php
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
